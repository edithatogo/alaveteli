<h2><%= _('More about this authority')%></h2>

<% home_page = public_body.safe_web_url(public_body.calculated_home_page) %>
<% if home_page %>
  <a href="<%= h(home_page) %>"><%= _('Home page of authority') %></a><br>
<% elsif public_body.calculated_home_page.present? %>
  <%= _('Home page of authority') %>: <%= public_body.calculated_home_page %><br>
<% end %>

<% publication_scheme = public_body.safe_web_url(public_body.publication_scheme) %>
<% if publication_scheme %>
  <a href="<%= h(publication_scheme) %>"><%= _('Publication scheme') %></a><br>
<% elsif public_body.publication_scheme.present? %>
  <%= _('Publication scheme') %>: <%= public_body.publication_scheme %><br>
<% end %>

<% disclosure_log = public_body.safe_web_url(public_body.disclosure_log) %>
<% if disclosure_log %>
  <a href="<%= h(disclosure_log) %>"><%= _('Disclosure log') %></a><br>
<% elsif public_body.disclosure_log.present? %>
  <%= _('Disclosure log') %>: <%= public_body.disclosure_log %><br>
<% end %>

<%= link_to _("Ask us to update FOI email"), new_change_request_body_path(:body => public_body.url_name) %><br>
