<li>
  <strong><%= invoice.created.to_fs(:long) %></strong>

  <%= _('Invoice {{invoice_number}} for {{invoice_amount}}',
        invoice_number: invoice.number,
        invoice_amount: format_currency(invoice.amount_due)) %>

  <% if invoice.paid? && invoice.receipt_url %>
    <%= stripe_document_link _('View Receipt'), invoice.receipt_url %>
  <% elsif invoice.open? && invoice.hosted_invoice_url %>
    <%= stripe_document_link _('View Invoice and Pay'),
                             invoice.hosted_invoice_url %>
  <% end %>
</li>
